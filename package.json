    "fadu": "./bin/fadu.mjs"
  },
  "files": [
    "src",
    "bin",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "build:data": "node scripts/build-data.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ifa",
    "fa",
    "odu",
    "divination",
    "benin",
    "yoruba",
    "fon",
    "west-africa",
    "geomancy",
    "binary"
  ],
  "author": "Christ-loisele Atidegla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catidegla/fadu.git"
  },
  "homepage": "https://github.com/catidegla/fadu#readme",
  "bugs": {
    "url": "https://github.com/catidegla/fadu/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
