{
  "name": "fadu",
  "version": "0.1.0",
  "description": "The structural layer of Fa and Ifa divination: the sixteen du, the 256 signs, and how a figure is cast. No interpretation, no dependencies.",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./data/du.json": "./data/du.json"
  },
